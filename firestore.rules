rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each student can read and write only their own record
    match /students/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // public XP board: anyone can read first name, class and daily XP; only the owner can write
    match /xp/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
